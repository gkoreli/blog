{
  "name": "gkoreli-blog",
  "private": true,
  "description": "Personal blog by Goga Koreli — built with @nisli/core",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "check:private-prompts": "node scripts/check-private-prompts.mjs tracked",
    "dev": "pnpm -C packages/blog dev",
    "build": "pnpm -C packages/blog build",
    "serve": "pnpm -C packages/blog serve",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "wrangler": "^4.71.0"
  }
}
