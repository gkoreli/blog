{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gkoreli-com",
	"compatibility_date": "2026-03-06",
	"main": "packages/blog/src/worker/index.ts",
	"routes": [
		{
			"pattern": "gkoreli.com",
			"custom_domain": true
		}
	],
	"secrets": {
		"required": ["ADMIN_SECRET", "ANALYTICS_HASH_KEY", "RESEND_API_KEY", "TURNSTILE_SECRET_KEY"]
	},
	// Workers Logs and Traces, matching the dashboard settings (2026-09-03) so a
	// deploy never turns them off. Free-plan retention is three days, subject to
	// collection limits. Captured request headers supplied research artifact 09
	// and TASK-0101; sampling=1 is not a guarantee that every event is retained.
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"assets": {
		"directory": "packages/blog/dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"html_handling": "drop-trailing-slash",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog-analytics",
			"database_id": "56fd8321-3499-48ba-bb45-a1a80a5a9b94",
			"migrations_dir": "packages/analytics/migrations"
		}
	],
	// Native Workers Rate Limiting: one shared per-IP budget for subscribe and resend.
	// Local, eventually consistent protection; D1 admission enforces shared mail limits.
	// (Cloudflare only supports period=10 or period=60; 60s chosen.)
	// Runs before Turnstile. Namespace ID is arbitrary; created on deploy.
	"ratelimits": [
		{
			"name": "SUBSCRIBE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				// 3 signup/resend attempts per minute per IP.
				// Cloudflare only allows period=10 or period=60.
				// Original intent was 3/5 min; 3/60s permits more sustained attempts.
				"limit": 3,
				"period": 60
			}
		}
	],
	"triggers": {
		// Nightly at 03:00 UTC:
		//   1. Purge pending rows with expired confirm tokens (24 h window)
		//   2. Purge unsubscribed/bounced rows and suppression older than 90 days
		//   3. Purge confirmation admission records older than seven days
		"crons": ["0 3 * * *"]
	}
}
