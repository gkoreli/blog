+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Newsletter inline form errors</title><script>document.documentElement.classList.add('js')</script><link rel="stylesheet" href="style.css"></head><body><main id="top"><h1>Engineering notes by email</h1><form id="newsletter-form" action="/subscribe" method="post"><label for="email">Email address</label><input id="email" name="email" type="email" required autocomplete="email" aria-invalid="false" aria-describedby="email-help" data-error="email-error"><p id="email-help">We send a confirmation link.</p><p id="email-error" hidden></p><button id="subscribe-submit" type="submit">Subscribe</button><p id="subscribe-status" role="status"></p><p id="validation-announcement" class="visually-hidden" aria-live="polite"></p></form></main><script>window.fixtureState={deletions:0,subscriptions:[]};window.removeSavedReport=()=>{window.fixtureState.deletions++;document.querySelector('#saved-report').hidden=true};window.acceptSubscription=email=>{window.fixtureState.subscriptions.push(email);return 'Request accepted. Check your inbox.'};</script><script src="app.js"></script></body></html>
