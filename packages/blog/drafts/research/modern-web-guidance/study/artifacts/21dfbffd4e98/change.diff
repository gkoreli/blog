-blog-reveal{display:block;opacity:0;transform:translateY(16px);transition:opacity .75s ease,transform .75s ease}blog-reveal.revealed{opacity:1;transform:none}
+/* Content stays readable until a working observer opts a card into motion. */
+blog-reveal{display:block;opacity:1;transform:none}
+@media (prefers-reduced-motion: no-preference){
+  blog-reveal.reveal-pending{opacity:0;transform:translateY(16px)}
+  blog-reveal.reveal-enabled.revealed{transition:opacity .75s ease,transform .75s ease}
+}
