-blog-reveal{display:block;opacity:0;transform:translateY(16px);transition:opacity .75s ease,transform .75s ease}blog-reveal.revealed{opacity:1;transform:none}
+/* Visible by default; only a working observer opts a card into waiting. */
+blog-reveal{display:block;opacity:1;transform:none}
+blog-reveal.reveal-enabled{transition:opacity .75s ease,transform .75s ease}
+blog-reveal.reveal-pending{opacity:0;transform:translateY(16px)}
+@media (prefers-reduced-motion:reduce){
+  blog-reveal.reveal-enabled,blog-reveal.reveal-pending{
+    opacity:1;transform:none;transition:none;animation:none;
+  }
+}
